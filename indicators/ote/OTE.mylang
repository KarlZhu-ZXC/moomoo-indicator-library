{ Smart Money Fibonacci OTE - experimental MyLang port v0.1 }
{ Indicator abbreviation: OTE_ML }
{ Full name: Smart Money Fib OTE MyLang }
{ Object: main chart / overlay }
{ No Parameter Settings entries are required; edit constants below. }
{ This is a location tool, not a Buy/Sell signal. }

{ ------------------------- USER CONSTANTS ------------------------- }
N:=5;
SHOWGRID:=1;
SHOWFILL:=0;
SHOWLABEL:=1;
INVALIDATE:=1;
FS:=0.618;
FO:=0.705;
FD:=0.786;

{ ---------------------- CONFIRMED PIVOTS ------------------------- }
PHC:=REF(H,N)=HHV(H,2*N+1);
PLC:=REF(L,N)=LLV(L,2*N+1);
PHT:=REF(H,N);
PLT:=REF(L,N);

PHAGO:=BARSLAST(REF(PHC,1))+1;
PLAGO:=BARSLAST(REF(PLC,1))+1;
PREVPH:=REF(PHT,PHAGO);
PREVPL:=REF(PLT,PLAGO);

HH0:=PHC AND PHT>PREVPH;
LL0:=PLC AND PLT<PREVPL;
RAW0:=HH0 OR LL0;
HASPREV:=COUNT(REF(RAW0,1),0)>0;

RAWUPAGE:=BARSLAST(HH0);
RAWDNAGE:=BARSLAST(LL0);
RAWDIR:=IF(RAWUPAGE<RAWDNAGE,1,-1);
PREVDIR:=REF(RAWDIR,1);

UPSHIFT:=HH0 AND ((PREVDIR<>1) OR NOT HASPREV);
DNSHIFT:=LL0 AND ((PREVDIR<>-1) OR NOT HASPREV);
SHIFT0:=UPSHIFT OR DNSHIFT;
HASSHIFT:=COUNT(SHIFT0,0)>0;

{ ------------------- DIRECTION AND ORIGIN ------------------------ }
UPAGE:=BARSLAST(UPSHIFT);
DNAGE:=BARSLAST(DNSHIFT);
DIR0:=IF(UPAGE<DNAGE,1,-1);
SAGE:=BARSLAST(SHIFT0);

UPORG:=REF(PLT,BARSLAST(PLC));
DNORG:=REF(PHT,BARSLAST(PHC));
ORGE:=IF(UPSHIFT,UPORG,DNORG);
ORIGIN:=REF(ORGE,SAGE);

{ Dynamic HHV/LLV period is the key client capability under test. }
WIN0:=MAX(1,MIN(SAGE+1,500));
EXTREME:=IF(DIR0=1,HHV(H,WIN0),LLV(L,WIN0));
RNG0:=ABS(EXTREME-ORIGIN);
HI0:=MAX(EXTREME,ORIGIN);
LO0:=MIN(EXTREME,ORIGIN);

{ ---------------------- LIFECYCLE ------------------------------- }
ORGBRK:=HASSHIFT AND IF(DIR0=1,L<ORIGIN,H>ORIGIN);
BAD0:=HASSHIFT AND BARSLAST(ORGBRK)<SAGE;
ACTIVE:=HASSHIFT AND RNG0>0 AND (INVALIDATE=0 OR NOT BAD0);
VIS0:=ACTIVE AND NOT SHIFT0;

{ -------------------- FIBONACCI GRID ---------------------------- }
F000:=IF(DIR0=1,HI0,LO0);
F236:=IF(DIR0=1,HI0-0.236*RNG0,LO0+0.236*RNG0);
F382:=IF(DIR0=1,HI0-0.382*RNG0,LO0+0.382*RNG0);
F500:=IF(DIR0=1,HI0-0.500*RNG0,LO0+0.500*RNG0);
F618:=IF(DIR0=1,HI0-FS*RNG0,LO0+FS*RNG0);
F705:=IF(DIR0=1,HI0-FO*RNG0,LO0+FO*RNG0);
F786:=IF(DIR0=1,HI0-FD*RNG0,LO0+FD*RNG0);
F100:=IF(DIR0=1,LO0,HI0);
ZTOP:=MAX(F618,F786);
ZBOT:=MIN(F618,F786);

{ Neutral full-grid lines. A gap on SHIFT0 avoids joining opposite grids. }
G000:IF(VIS0 AND SHOWGRID=1,F000,DRAWNULL),DOTLINE,COLOR878B94;
G236:IF(VIS0 AND SHOWGRID=1,F236,DRAWNULL),DOTLINE,COLOR878B94;
G382:IF(VIS0 AND SHOWGRID=1,F382,DRAWNULL),DOTLINE,COLOR878B94;
G500:IF(VIS0 AND SHOWGRID=1,F500,DRAWNULL),DOTLINE,COLOR878B94;
G100:IF(VIS0 AND SHOWGRID=1,F100,DRAWNULL),DOTLINE,COLOR878B94;

{ Bullish OTE lines. }
B618:IF(VIS0 AND DIR0=1,F618,DRAWNULL),LINETHICK2,COLOR089981;
B705:IF(VIS0 AND DIR0=1,F705,DRAWNULL),DOTLINE,LINETHICK2,COLOR089981;
B786:IF(VIS0 AND DIR0=1,F786,DRAWNULL),LINETHICK2,COLOR089981;

{ Bearish OTE lines. }
S618:IF(VIS0 AND DIR0=-1,F618,DRAWNULL),LINETHICK2,COLORF23645;
S705:IF(VIS0 AND DIR0=-1,F705,DRAWNULL),DOTLINE,LINETHICK2,COLORF23645;
S786:IF(VIS0 AND DIR0=-1,F786,DRAWNULL),LINETHICK2,COLORF23645;

{ MyLang alpha colors were rejected in client testing. Fill is off by default. }
FILLRGN(ZTOP,ZBOT,ACTIVE AND DIR0=1 AND SHOWFILL=1),COLORDDF5EF;
FILLRGN(ZTOP,ZBOT,ACTIVE AND DIR0=-1 AND SHOWFILL=1),COLORFFE6E8;

DRAWTEXT(ISLASTBAR AND ACTIVE AND DIR0=1 AND SHOWLABEL=1,ZBOT,'Bull OTE'),COLOR089981;
DRAWTEXT(ISLASTBAR AND ACTIVE AND DIR0=-1 AND SHOWLABEL=1,ZTOP,'Bear OTE'),COLORF23645;
