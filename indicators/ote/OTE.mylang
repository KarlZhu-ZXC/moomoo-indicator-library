{ Smart Money Fibonacci OTE - experimental MyLang port v0.3 }
{ Indicator abbreviation: OTE_ML }
{ Full name: Smart Money Fib OTE MyLang }
{ Object: main chart / overlay }
{ No Parameter Settings entries are required; edit constants below. }
{ This is a location tool, not a Buy/Sell signal. }

{ ------------------------- USER CONSTANTS ------------------------- }
N:=5;
SHOWGRID:=1;
SHOWFILL:=0;
SHOWLABEL:=1;
SHOWFIBTXT:=1;
INVALIDATE:=0;
DEBUG:=0;
FS:=0.618;
FO:=0.705;
FD:=0.786;

{ ---------------------- CONFIRMED PIVOTS ------------------------- }
PHC:=REF(H,N)=HHV(H,2*N+1);
PLC:=REF(L,N)=LLV(L,2*N+1);
PHT:=REF(H,N);
PLT:=REF(L,N);

PHAGO:=BARSLAST(REF(PHC,1))+1;
PLAGO:=BARSLAST(REF(PLC,1))+1;
PREVPH:=REF(PHT,PHAGO);
PREVPL:=REF(PLT,PLAGO);

HH0:=PHC AND PHT>PREVPH;
LL0:=PLC AND PLT<PREVPL;
VALIDUP:=HH0;
VALIDDN:=LL0;

{ MyLang v0.2 refreshes the current leg on every valid structural HH/LL. }
UPSHIFT:=VALIDUP;
DNSHIFT:=VALIDDN;
SHIFT0:=UPSHIFT OR DNSHIFT;

{ ------------------- DIRECTION AND ORIGIN ------------------------ }
UPAGE:=BARSLAST(UPSHIFT);
DNAGE:=BARSLAST(DNSHIFT);
DIR0:=IF(UPAGE<DNAGE,1,0-1);
SAGE:=BARSLAST(SHIFT0);
HASSHIFT:=SAGE<BARSCOUNT(C);

UPORG:=REF(PLT,BARSLAST(PLC));
DNORG:=REF(PHT,BARSLAST(PHC));
ORGE:=IF(UPSHIFT,UPORG,DNORG);
ORIGIN:=REF(ORGE,SAGE);

{ Dynamic HHV/LLV period is the key client capability under test. }
WIN0:=MAX(1,MIN(SAGE+1,500));
EXTREME:=IF(DIR0=1,HHV(H,WIN0),LLV(L,WIN0));
RNG0:=ABS(EXTREME-ORIGIN);
HI0:=MAX(EXTREME,ORIGIN);
LO0:=MIN(EXTREME,ORIGIN);

{ ---------------------- LIFECYCLE ------------------------------- }
ORGBRK:=HASSHIFT AND IF(DIR0=1,L<ORIGIN,H>ORIGIN);
BAD0:=HASSHIFT AND BARSLAST(ORGBRK)<SAGE;
ACTIVE:=HASSHIFT AND RNG0>0 AND (INVALIDATE=0 OR BAD0=0);
VIS0:=ACTIVE AND SHIFT0=0;

{ -------------------- FIBONACCI GRID ---------------------------- }
F000:=IF(DIR0=1,HI0,LO0);
F236:=IF(DIR0=1,HI0-0.236*RNG0,LO0+0.236*RNG0);
F382:=IF(DIR0=1,HI0-0.382*RNG0,LO0+0.382*RNG0);
F500:=IF(DIR0=1,HI0-0.500*RNG0,LO0+0.500*RNG0);
F618:=IF(DIR0=1,HI0-FS*RNG0,LO0+FS*RNG0);
F705:=IF(DIR0=1,HI0-FO*RNG0,LO0+FO*RNG0);
F786:=IF(DIR0=1,HI0-FD*RNG0,LO0+FD*RNG0);
F100:=IF(DIR0=1,LO0,HI0);
ZTOP:=MAX(F618,F786);
ZBOT:=MIN(F618,F786);

{ CONST is client-confirmed: freeze the latest grid across its current span. }
CSAGE:=CONST(SAGE);
CDIR:=CONST(DIR0);
CACT:=CONST(ACTIVE);
CF000:=CONST(F000);
CF236:=CONST(F236);
CF382:=CONST(F382);
CF500:=CONST(F500);
CF618:=CONST(F618);
CF705:=CONST(F705);
CF786:=CONST(F786);
CF100:=CONST(F100);
CZTOP:=CONST(ZTOP);
CZBOT:=CONST(ZBOT);
CVIS:=CACT AND CURRBARSCOUNT<=CSAGE+1;

{ Neutral current-grid lines. }
G000:IF(CVIS AND SHOWGRID=1,CF000,DRAWNULL),DOTLINE,COLOR878B94;
G236:IF(CVIS AND SHOWGRID=1,CF236,DRAWNULL),DOTLINE,COLOR878B94;
G382:IF(CVIS AND SHOWGRID=1,CF382,DRAWNULL),DOTLINE,COLOR878B94;
G500:IF(CVIS AND SHOWGRID=1,CF500,DRAWNULL),DOTLINE,COLOR878B94;
G100:IF(CVIS AND SHOWGRID=1,CF100,DRAWNULL),DOTLINE,COLOR878B94;

{ Bullish OTE lines. }
B618:IF(CVIS AND CDIR=1,CF618,DRAWNULL),LINETHICK2,COLOR089981;
B705:IF(CVIS AND CDIR=1,CF705,DRAWNULL),DOTLINE,LINETHICK2,COLOR089981;
B786:IF(CVIS AND CDIR=1,CF786,DRAWNULL),LINETHICK2,COLOR089981;

{ Bearish OTE lines. }
S618:IF(CVIS AND CDIR<0,CF618,DRAWNULL),LINETHICK2,COLORF23645;
S705:IF(CVIS AND CDIR<0,CF705,DRAWNULL),DOTLINE,LINETHICK2,COLORF23645;
S786:IF(CVIS AND CDIR<0,CF786,DRAWNULL),LINETHICK2,COLORF23645;

{ MyLang alpha colors were rejected in client testing. Fill is off by default. }
FILLRGN(CZTOP,CZBOT,CVIS AND CDIR=1 AND SHOWFILL=1),COLORDDF5EF;
FILLRGN(CZTOP,CZBOT,CVIS AND CDIR<0 AND SHOWFILL=1),COLORFFE6E8;

DRAWTEXT(ISLASTBAR AND CACT AND CDIR=1 AND SHOWLABEL=1,CZBOT,'Bull OTE'),COLOR089981;
DRAWTEXT(ISLASTBAR AND CACT AND CDIR<0 AND SHOWLABEL=1,CZTOP,'Bear OTE'),COLORF23645;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF000,'0.000'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF236,'0.236'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF382,'0.382'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF500,'0.500'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF618,'0.618'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF705,'0.705'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF786,'0.786'),COLOR878B94;
DRAWTEXT(ISLASTBAR AND CACT AND SHOWFIBTXT=1,CF100,'1.000'),COLOR878B94;

{ ----------------------- DEBUG LAYER ----------------------------- }
PHBACK:=FILTER(BACKSET(PHC,N+1),N);
PLBACK:=FILTER(BACKSET(PLC,N+1),N);
DRAWTEXT(DEBUG=1 AND PHBACK,H,'PH'),COLORF23645;
DRAWTEXT(DEBUG=1 AND PLBACK,L,'PL'),COLOR089981;
DRAWTEXT(DEBUG=1 AND HH0,PHT,'HH'),COLORF23645;
DRAWTEXT(DEBUG=1 AND LL0,PLT,'LL'),COLOR089981;
DRAWTEXT(DEBUG=1 AND UPSHIFT,H,'UP SHIFT'),COLOR089981;
DRAWTEXT(DEBUG=1 AND DNSHIFT,L,'DN SHIFT'),COLORF23645;
DRAWTEXT(DEBUG=1 AND ISLASTBAR AND HASSHIFT=0,C,'OTE waiting for valid HH/LL'),COLOR878B94;
DRAWTEXT(DEBUG=1 AND ISLASTBAR AND HASSHIFT=1 AND ACTIVE=0,C,'OTE inactive'),COLOR878B94;
